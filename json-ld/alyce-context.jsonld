      "@id": "alyce:Gift",
      "@type": "@id"
    },
    "Recipient": {
      "@id": "alyce:Recipient",
      "@type": "@id"
    },
    "Budget": {
      "@id": "alyce:Budget",
      "@type": "@id"
    },
    "Marketplace": {
      "@id": "alyce:Marketplace",
